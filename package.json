{
  "name": "univer-cli-examples",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "example:quick-start": "pnpm --filter @univer-cli-example/quick-start-cli build && pnpm --filter @univer-cli-example/quick-start-cli start:built",
    "example:univer-mini": "pnpm --filter @univer-cli-example/univer-mini-cli build && pnpm --filter @univer-cli-example/univer-mini-cli start:built",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
